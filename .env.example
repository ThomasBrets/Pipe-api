# ============================================================
# Variables de entorno - Pipe E-commerce API
# ============================================================
# Copiá este archivo como .env y completá los valores reales:
#   cp .env.example .env
# ============================================================

# MongoDB connection string (Atlas o local)
# Formato Atlas: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DB_NAME
# Formato local: mongodb://localhost:27017/DB_NAME
MONGODB_URL=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster.mongodb.net/pipe-ecommerce

# Puerto donde corre el servidor (default: 3000)
PORT=3000

# Clave secreta para firmar los JWT (usar una cadena larga y aleatoria)
# Generá una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Cuenta de Gmail para envío de emails (Nodemailer)
EMAIL_USER=your_email@gmail.com

# App password de Gmail (no es la contraseña normal de la cuenta)
# Generala en: Google Account → Security → 2FA → App passwords
EMAIL_PASS=your_gmail_app_password
